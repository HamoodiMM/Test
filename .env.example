PORT=3000

# MongoDB Atlas connection string (database: test-app)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/test-app?retryWrites=true&w=majority

# Long random string that signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<long-random-string>

# Free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Backup models, tried in order when GEMINI_MODEL is out of quota, overloaded or too slow
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000

# Paid-tier prices in USD per 1M tokens, used to show the cost of each message
GEMINI_INPUT_PRICE_PER_MILLION=0.30
GEMINI_OUTPUT_PRICE_PER_MILLION=2.50
